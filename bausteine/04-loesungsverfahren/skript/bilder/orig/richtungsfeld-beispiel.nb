Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"plot", "[", 
    RowBox[{"s_", ",", 
     RowBox[{"pps_:", "True"}], ",", 
     RowBox[{"a1_:", 
      RowBox[{"1", "/", "2"}]}], ",", 
     RowBox[{"a2_:", 
      RowBox[{"1", "/", "8"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "slope", ",", " ", "l", ",", " ", "phi", ",", " ", "dx", ",", " ", "dy",
        ",", "f1", ",", "f2", ",", "p1", ",", "p2"}], "}"}], 
     "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"f1", "=", 
       RowBox[{"Quiet", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"y", "[", "x", "]"}], "/.", 
          RowBox[{"NDSolve", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"y", "'"}], "[", "x", "]"}], "\[Equal]", 
               RowBox[{"(", 
                RowBox[{"s", "/.", 
                 RowBox[{"y", "\[Rule]", 
                  RowBox[{"y", "[", "x", "]"}]}]}], ")"}]}], ",", 
              RowBox[{
               RowBox[{"y", "[", "0", "]"}], "\[Equal]", "a1"}]}], "}"}], ",", 
            RowBox[{"y", "[", "x", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "//", 
         "First"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"p1", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", "f1", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"PlotRange", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"Directive", "[", 
           RowBox[{"{", 
            RowBox[{"Thick", ",", "Red"}], "}"}], "]"}]}], ",", 
         RowBox[{"PlotTheme", "\[Rule]", "\"\<Scientific\>\""}], ",", 
         RowBox[{"FrameTicks", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0.5", ",", "1"}], "}"}], ",", 
              RowBox[{"{", "}"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0.5", ",", "1"}], "}"}], ",", 
              RowBox[{"{", "}"}]}], "}"}]}], "}"}]}], ",", 
         RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
         RowBox[{"ImageSize", "\[Rule]", "250"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"p2", "=", 
       RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"slope", "=", 
             RowBox[{"s", "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"x", "\[Rule]", "xx"}], ",", 
                RowBox[{"y", "\[Rule]", "yy"}]}], "}"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"slope", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"NumberQ", "[", "slope", "]"}], ",", "slope", ",", 
               "10000"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"l", "=", "0.045"}], ";", "\[IndentingNewLine]", 
            RowBox[{"phi", "=", 
             RowBox[{"ArcTan", "[", "slope", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"dx", "=", 
             RowBox[{
              RowBox[{"Cos", "[", "phi", "]"}], "*", "l"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"dy", "=", 
             RowBox[{
              RowBox[{"Sin", "[", "phi", "]"}], "*", "l"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{"Blue", ",", 
              RowBox[{"AbsoluteThickness", "[", "1.25", "]"}], 
              "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
              RowBox[{"Line", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"xx", "-", "dx"}], ",", 
                   RowBox[{"yy", "-", "dy"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"xx", "+", "dx"}], ",", 
                   RowBox[{"yy", "+", "dy"}]}], "}"}]}], "}"}], "]"}], 
              "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Directive", "[", "Orange", "]"}], 
                "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                RowBox[{"Disk", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"xx", ",", "yy"}], "}"}], ",", "0.01"}], "]"}]}], 
               "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "}"}]}],
            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"xx", ",", "0", ",", "1", ",", "0.125"}], "}"}], 
           "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"yy", ",", "0", ",", "1", ",", "0.125"}], "}"}]}], 
          "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "}"}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", "\[IndentingNewLine]", 
       RowBox[{"pps", ",", "\[IndentingNewLine]", 
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"p1", ",", "p2"}], "}"}], ",", 
          RowBox[{"PlotRange", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "0.1"}], ",", "1.1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "0.1"}], ",", "1.1"}], "}"}]}], "}"}]}]}], "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"{", "p2", "}"}], ",", 
          RowBox[{"PlotRange", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "0.1"}], ",", "1.1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "0.1"}], ",", "1.1"}], "}"}]}], "}"}]}]}], 
         "]"}]}], "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"p", "=", 
  RowBox[{"plot", "[", 
   RowBox[{
    RowBox[{"x", "-", "y"}], ",", "True", ",", 
    RowBox[{"1", "/", "2"}]}], "]"}]}], "\[IndentingNewLine]", 
